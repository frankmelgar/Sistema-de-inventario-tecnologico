# Incluye este bloque dentro del server{} de Nginx para replicar las reglas Apache.
autoindex off;

location ~ /\.(env|git) {
    deny all;
}

location ~* \.sql$ {
    deny all;
}

location ~ ^/(dev|tmp|scripts|migrations)(/|$) {
    deny all;
}

location ~ ^/(config|includes)(/|$) {
    deny all;
}

location ~ ^/uploads/.*\.(php|phtml|phar|cgi|pl|asp|aspx|jsp|sh|bat|cmd|svg)$ {
    deny all;
}

add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

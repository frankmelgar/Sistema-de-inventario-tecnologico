Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|cgi|pl|asp|aspx|jsp|sh|bat|cmd|svg)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|cgi|pl|asp|aspx|jsp|sh|bat|cmd|svg)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
